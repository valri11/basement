var (
{% for m in attr.type.members %}
	{{ [m.brief] | select | join("") | comment(indent=1) }}
	{{ go_name(attr.key) }}{{ go_name(m.id) }} = {{ go_name(attr.key) }}Key.{{ go_setter(attr.type) }}({{ m.value | tojson }})
{% endfor %}
)
{% endif %}
{% endfor %}
