{% macro go_name(s) %}{% for w in s | split(".") %}{% for p in w | split("_") %}{{ p | pascal_case | acronym }}{% endfor %}{% endfor %}{% endmacro %}
{% macro go_value_type(t) %}{% if t is mapping %}{% if t.members[0].value is string %}string{% else %}int{% endif %}{% else %}{{ t | map_text("go_type") }}{% endif %}{% endmacro %}
{% macro go_setter(t) %}{% if t is mapping %}{% if t.members[0].value is string %}String{% else %}Int{% endif %}{% else %}{{ t | map_text("go_attr_value") }}{% endif %}{% endmacro %}
