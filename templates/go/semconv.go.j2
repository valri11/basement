{% for attr in ctx.attributes %}
	{{ [attr.brief, attr.note] | select | join("\n\n") | comment(indent=1) }}
	{{ go_name(attr.key) }}Key = attribute.Key("{{ attr.key }}")
{% endfor %}
)
{% for attr in ctx.attributes %}

// {{ go_name(attr.key) }} returns a {{ attr.key }} attribute.
func {{ go_name(attr.key) }}(val {{ go_value_type(attr.type) }}) attribute.KeyValue {
